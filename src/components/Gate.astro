---
import { SITE } from '../data/site';
import Magnet from './rb/Magnet.astro';
import { localizePath, type Lang } from '../i18n';
import { productShots } from '../data/shots';
interface Props { lang: Lang }
const { lang } = Astro.props;
const doors = [SITE.gate.brief, SITE.gate.projects];
const shots = productShots();
---
<nav class="gate" aria-label={SITE.gate.label[lang]}>
  {doors.map((d, i) => (
    <a class:list={['door', { 'door--ink': i === 1 }]} href={localizePath(d.href, lang)}>
      <span class="door__index" data-m-pre>{d.index}</span>
      <span class="door__big" aria-hidden="true" data-m-pre>{d.big}</span>
      <span class="door__title" data-m-pre>{d.title[lang]}<Magnet className="door__magnet"><span class="door__arrow" aria-hidden="true">→</span></Magnet></span>
      <span class="door__desc" data-m-pre>{d.desc[lang]}</span>
      {i === 1 && (
        /* Real screenshots of the live editions; the link's own words name the door, so the pictures are decoration here. */
        <span class="door__shots" aria-hidden="true" data-m-pre>{shots.map(s => <img src={s.img.file} width={s.img.w} height={s.img.h} alt="" decoding="async" />)}</span>
      )}
    </a>
  ))}
</nav>
<script>
  import { initDoorTransition } from '../scripts/door-transition-dom';
  import { stage } from '../scripts/motion/arm';
  const gate = document.querySelector<HTMLElement>('.gate');
  if (gate) {
    initDoorTransition(gate);
    // After the name: both big words rise one after the other, then each door's title and line follow.
    const parts = (cls: string) => [...gate.querySelectorAll<HTMLElement>(`.${cls}[data-m-pre]`)];
    stage([...parts('door__big'), ...parts('door__index'), ...parts('door__title'), ...parts('door__desc'), ...parts('door__shots')], { delay: 420, step: 90 });
  }
</script>
<style>
  .gate { display: grid; grid-template-columns: 1fr 1fr; border-block: var(--rule); }
  .door { display: grid; grid-template-rows: auto 1fr auto auto; gap: 12px; min-height: clamp(260px, 40vh, 440px); padding: 28px var(--gutter) 32px; background: var(--paper); color: var(--ink); text-decoration: none; transition: background-color 0.25s var(--ease); }
  .door + .door { border-left: var(--rule); }
  .door--ink { background: var(--ink); color: var(--paper); }
  /* Three real product details share the first row with the door's number, at its right; the row grows to hold them,
     so the big word below can never run into them. In their own colours; pointing at the door lifts them a little. */
  .door__index, .door__shots { grid-row: 1; grid-column: 1; }
  .door__index { align-self: start; }
  .door__shots { justify-self: end; display: flex; gap: 12px; width: min(calc(100% - 48px), 450px); }
  .door__shots img { flex: 1; min-width: 0; height: auto; aspect-ratio: 16 / 10; object-fit: cover; transition: transform 0.5s var(--ease); }
  .door--ink:hover .door__shots img, .door--ink:focus-visible .door__shots img { transform: translateY(-4px); }
  @media (max-width: 800px) { .door__shots { display: none; } }
  .door__index { font: 700 14px/1 var(--font-display); letter-spacing: 0.2em; }
  .door__big { align-self: end; font: 700 clamp(88px, 13vw, 200px)/0.8 var(--font-display); }
  .door__title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4em; font: 900 clamp(22px, 2.4vw, 34px)/1.2 var(--font-cjk-bold); }
  .door__arrow { color: var(--red); }
  .door :global(.door__magnet) { margin-left: 0.1em; }
  .door__desc { color: var(--mute); font-size: 15px; }
  :global(html.motion-ok:not(.motion-timeout)) .door [data-m-pre]:not(:global(.m-armed)) { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .door :global(.m-armed) { opacity: 0; transform: translateY(14px); }
    .door .door__big:global(.m-armed:not(.m-in)) { transform: translateY(0.3em); }
    .door :global(.m-armed.m-in) { opacity: 1; transform: none; transition: opacity 0.7s var(--ease) var(--m-d, 0ms), transform 1s var(--ease) var(--m-d, 0ms); }
  }
  .door--ink .door__desc { color: var(--night-mute); }
  .door:hover { background: #e6e5de; }
  .door--ink:hover { background: #222; }
  .door:focus-visible { outline-offset: -8px; }
  @media (max-width: 640px) {
    .gate { grid-template-columns: 1fr; }
    .door + .door { border-left: 0; border-top: var(--rule); }
    .door { min-height: 0; padding-block: 22px 26px; }
    .door__big { font-size: 88px; }
  }
</style>
