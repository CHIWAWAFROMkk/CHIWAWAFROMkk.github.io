---
/* Adapted from React Bits — ScrollReveal (ts-default); behaviour in scripts/motion/reveal.ts.
 * Copyright (c) 2026 David Haz. MIT + Commons Clause; see LICENSE.md. */
interface Props { text: string; className?: string }
const { text, className = '' } = Astro.props;
---
<span class:list={['scroll-reveal', className]} style="display:inline-block">{text}</span>
<script>
  import { initScrollReveal } from '../../scripts/motion/reveal';
  for (const el of document.querySelectorAll<HTMLElement>('.scroll-reveal')) initScrollReveal(el);
</script>
