---
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
// Captured at 2x by QuotaDeck's own desktop test on synthetic data, from the merged notch commit just before the 0.7.0 tag
// (portfolio-site/work/qd-materials); the HUD is the one 0.7.0 ships.
const SHOTS = [
  { id: 'strip', w: 185, h: 377, zh: '贴边浮条：每家一个额度环，数字是已用比例，余额类写余额', en: 'Edge strip: one ring per service; the number is the share used, or the balance for prepaid ones' },
  { id: 'card', w: 1077, h: 687, zh: '额度卡片：5 小时与每周窗口、重置时间，以及过去一天的 Token 柱', en: 'Quota card: 5-hour and weekly windows, reset times, and the past day of token bars' },
  { id: 'reply', w: 1077, h: 693, zh: '做完了提醒：Claude Code 一轮结束后留在 HUD 上，直到看过为止', en: 'Done reminder: when a Claude Code turn ends, it stays on the HUD until you have seen it' },
  { id: 'approval', w: 1076, h: 728, zh: '批准卡片：Claude Code 请求执行命令时，直接在 HUD 上允许或拒绝', en: 'Approval card: when Claude Code asks to run a command, allow or deny it on the HUD' },
  { id: 'notch', w: 928, h: 698, zh: '顶部黑块（Notch）：屏幕顶部正中的一块黑色，外圈的光按额度着色，卡片挂在下方', en: 'Notch: a black block at the top centre; its glow takes the quota colours, and cards hang below it' },
];
const title = zh ? '桌面版截图' : 'The desktop app: screenshots';
const note = zh
  ? '截图由 QuotaDeck 自带的桌面测试在合成数据上截取，不含真实额度、会话内容或账户信息。界面复刻自 Agent HUD（Apache-2.0）。'
  : 'Captured by QuotaDeck’s own desktop test on synthetic data: no real quota, session content or account details. The interface copies Agent HUD (Apache-2.0).';
---
<section class="qshots wrap" aria-labelledby="qshots-title">
  <div class="section-head"><h2 id="qshots-title">{title}</h2></div>
  <p class="qshots__note">{note}</p>
  <div class="qshots__row">
    {SHOTS.map(s => (
      <figure data-shot={s.id}>
        <div class="qshots__pane"><img src={`/media/quota-deck/hud/${s.id}.png`} alt={zh ? s.zh : s.en} width={s.w} height={s.h} loading="lazy" decoding="async" /></div>
        <figcaption>{zh ? s.zh : s.en}</figcaption>
      </figure>
    ))}
  </div>
</section>
<script>
  import { reveal } from '../scripts/motion-dom';
  reveal(document.querySelectorAll('.qshots figure'), 140);
</script>
<style>
  .qshots { padding-bottom: 32px; }
  .qshots__note { max-width: 52em; margin: 14px 0 20px; color: var(--mute); font-size: 14px; }
  .qshots__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  figure { margin: 0; display: grid; grid-template-rows: 1fr auto; }
  /* The HUD is drawn for a dark desktop; its transparent screenshots sit on the night tone. */
  .qshots__pane { display: grid; place-items: center; padding: 20px; background: radial-gradient(120% 90% at 20% 10%, #2d3748 0%, #1a1f29 55%, #0e1117 100%); }
  img { width: 100%; height: auto; }
  /* Captured at 2x: shown at their real size, never blown up. */
  [data-shot='strip'] img { max-width: 93px; }
  [data-shot='card'] img, [data-shot='reply'] img, [data-shot='approval'] img { max-width: 539px; }
  [data-shot='notch'] img { max-width: 464px; }
  figcaption { margin-top: 10px; font-size: 14px; }
  @media (max-width: 800px) { .qshots__row { grid-template-columns: minmax(0, 1fr); } }
</style>
