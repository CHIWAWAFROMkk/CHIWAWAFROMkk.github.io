---
import { CAREER_TEXT } from '../scripts/career-text';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = CAREER_TEXT[lang];
const TABLES = ['matches', 'gates', 'review'] as const;
---
<section class="career wrap" data-career data-demo data-lang={lang} aria-labelledby="career-title">
  <div class="section-head"><h2 id="career-title">{T.title}</h2><span class="meta">{T.meta}</span></div>
  <p class="career__intro">{T.intro}</p>
  {T.dataNote && <p class="meta">{T.dataNote}</p>}
  <div class="career__controls">
    <label>{T.daysLabel}<select id="agent-days" disabled>{T.days.map(([v, t]) => <option value={v}>{t}</option>)}</select></label>
    <label>{T.evidenceLabel}<select id="agent-evidence" disabled>{T.evidence.map(([v, t]) => <option value={v}>{t}</option>)}</select></label>
  </div>
  <p id="agent-status" class="notice" role="status" aria-live="polite">{T.loading}</p>
  <button id="agent-retry" type="button" class="secondary" hidden>{T.retry}</button>
  <div id="agent-results" hidden>
    <div class="career__io">
      <div><h3>{T.jdTitle}</h3><pre id="agent-jd" tabindex="0"></pre></div>
      <div><h3>{T.profileTitle}</h3><p class="meta">{T.profileNote}</p><div id="agent-profile" class="career__facts"></div></div>
    </div>
    <h3>{T.outTitle}</h3>
    <dl class="career__kpi">
      <div><dt>{T.kpi.score}</dt><dd id="agent-score"></dd></div>
      <div><dt>{T.kpi.facts}</dt><dd id="agent-facts"></dd></div>
      <div><dt>{T.kpi.blocks}</dt><dd id="agent-blocks"></dd></div>
      <div><dt>{T.kpi.recommendation}</dt><dd id="agent-recommendation" class="career__rec"></dd></div>
    </dl>
    <p class="meta">{T.scoreNote}</p>
    <p id="agent-observation" class="career__obs"></p>
    <details class="career__more">
      <summary>{T.breakdownTitle}</summary>
      <p class="meta">{T.breakdownNote}</p>
      <dl id="agent-breakdown" class="career__breakdown"></dl>
      <ul id="agent-reasons"></ul>
    </details>
    {TABLES.map(id => (
      <div class="career__table">
        <h3>{T.tables[id]}</h3>
        <div class="table-wrap" role="region" tabindex="0" aria-label={`${T.tables[id]} · ${T.scrollHint}`}>
          <table><thead><tr>{T.heads[id].map(h => <th scope="col">{h}</th>)}</tr></thead><tbody id={`agent-${id}`}></tbody></table>
        </div>
      </div>
    ))}
    <h3>{T.draftTitle}</h3>
    <label>{T.materialLabel}<select id="agent-material">{T.materials.map(([v, t]) => <option value={v}>{t}</option>)}</select></label>
    <pre id="agent-draft" tabindex="0"></pre>
    <p class="meta">{T.draftNote}</p>
    <p class="meta">{T.noSubmit}</p>
    <div class="actions"><button id="agent-export" type="button">{T.exportOne}</button><a href="/assets/job-agent-demo.json" download>{T.exportAll}</a></div>
  </div>
</section>
<script>
  import { initCareer } from '../scripts/career-ui';
  document.querySelectorAll<HTMLElement>('[data-career]').forEach(initCareer);
</script>
<style>
  .career { padding-bottom: 40px; }
  .career__intro { max-width: 52em; margin: 16px 0 8px; font-size: 16px; }
  .meta { color: var(--mute); font-size: 14px; }
  .career__controls { display: flex; flex-wrap: wrap; gap: 16px 28px; margin: 18px 0; }
  label { display: grid; justify-items: start; gap: 6px; min-width: 0; max-width: 100%; font-weight: 500; font-size: 14px; }
  select { min-width: min(12em, 100%); max-width: 100%; padding: 9px 10px; border: 1.5px solid var(--ink); background: #fff; font: inherit; font-size: 16px; border-radius: 0; color: var(--ink); }
  .notice { padding: 10px 14px; border-left: 4px solid var(--ink); background: #fff; font-size: 14px; }
  button { padding: 9px 16px; border: 1.5px solid var(--ink); background: var(--ink); color: var(--paper); font-weight: 700; cursor: pointer; border-radius: 0; }
  button.secondary { background: transparent; color: var(--ink); }
  button:hover { background: var(--red-text); border-color: var(--red-text); color: #fff; }
  h3 { margin: 28px 0 10px; font-size: 20px; }
  .career__io { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; }
  pre { max-height: 320px; overflow: auto; margin: 0; padding: 14px 16px; background: #fff; border: var(--hair); font: 14px/1.7 var(--font-body); white-space: pre-wrap; }
  .career__facts :global(p) { display: grid; gap: 2px; padding: 10px 0; border-bottom: var(--hair); }
  .career__facts :global(.tag) { justify-self: start; padding: 1px 6px; background: var(--ink); color: var(--paper); font-size: 12px; }
  .career__facts :global(small) { color: var(--mute); font-size: 12px; }
  .career__kpi { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: var(--rule); border-bottom: var(--rule); }
  .career__kpi div { padding: 16px 12px 16px 0; }
  .career__kpi div + div { padding-left: 16px; border-left: var(--hair); }
  .career__kpi dt { color: var(--mute); font-size: 13px; }
  .career__kpi dd { font: 700 clamp(34px, 4vw, 56px)/1 var(--font-display); }
  .career__kpi dd.career__rec { font: 900 clamp(20px, 2vw, 28px)/1.3 var(--font-cjk-bold); color: var(--red-text); }
  .career__obs { max-width: 52em; margin-top: 14px; padding: 12px 14px; border-left: 4px solid var(--red-text); background: #fff; }
  .career__more { margin-top: 16px; }
  .career__more summary { cursor: pointer; font-weight: 500; }
  .career__breakdown { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px 24px; margin: 12px 0; }
  .career__breakdown :global(div) { display: flex; justify-content: space-between; border-bottom: var(--hair); padding: 6px 0; }
  .table-wrap { overflow-x: auto; max-width: 100%; }
  .table-wrap :global(table) { width: 100%; border-collapse: collapse; font-size: 14px; }
  .table-wrap :global(th), .table-wrap :global(td) { padding: 8px 10px; border-bottom: var(--hair); text-align: left; vertical-align: top; min-width: 7em; }
  .table-wrap :global(th) { border-bottom: var(--rule); font-weight: 500; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 14px; }
  @media (max-width: 800px) {
    .career__io { grid-template-columns: minmax(0, 1fr); }
    .career__kpi { grid-template-columns: 1fr 1fr; }
    .career__kpi div + div:nth-child(3) { padding-left: 0; border-left: 0; }
    .career__breakdown { grid-template-columns: minmax(0, 1fr); }
  }
</style>
