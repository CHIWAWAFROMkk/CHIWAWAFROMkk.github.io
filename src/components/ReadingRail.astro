---
import { SITE } from '../data/site';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<nav class="rail" aria-label={SITE.rail.label[lang]} data-rail-nav hidden><ol></ol></nav>
<div class="rail-bar" aria-hidden="true" data-rail-bar hidden></div>
<script>
  import { initReadingRail } from '../scripts/reading-rail';
  const nav = document.querySelector<HTMLElement>('[data-rail-nav]');
  const bar = document.querySelector<HTMLElement>('[data-rail-bar]');
  if (nav && bar) initReadingRail(nav, bar);
</script>
<style>
  .rail { position: fixed; z-index: 20; left: max(8px, calc(var(--gutter) / 2 - 5px)); top: 50%; transform: translateY(-50%); transition: opacity 0.3s var(--ease); }
  .rail.is-over-night { opacity: 0; pointer-events: none; }
  .rail.is-over-night:focus-within { opacity: 1; pointer-events: auto; }
  .rail ol { position: relative; display: grid; gap: 22px; margin: 0; padding: 0; list-style: none; }
  .rail ol::before, .rail ol::after { content: ''; position: absolute; left: 4px; top: 4px; bottom: 4px; width: 1.5px; }
  .rail ol::before { background: var(--ink); opacity: 0.25; }
  .rail ol::after { background: var(--red); transform: scaleY(var(--progress, 0)); transform-origin: top; transition: transform 0.4s var(--ease); }
  /* Each link is a 10 px node; its name sits 22 px to the right in a span that ignores the pointer, shown on hover and focus only. */
  .rail :global(a) { position: relative; display: block; width: 10px; height: 10px; border: 1.5px solid var(--ink); background: var(--paper); text-decoration: none; transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease); }
  .rail :global(a[aria-current]) { background: var(--red); border-color: var(--red); }
  .rail :global(.rail__label) { position: absolute; left: 22px; top: 50%; transform: translateY(-50%); padding: 2px 6px; background: var(--paper); color: var(--ink); font-size: 13px; line-height: 1.2; white-space: nowrap; pointer-events: none; opacity: 0; transition: opacity 0.2s var(--ease); }
  .rail :global(a:hover .rail__label), .rail :global(a:focus-visible .rail__label) { opacity: 1; }
  .rail.is-still ol::after, .rail.is-still :global(a), .rail.is-still :global(.rail__label) { transition: none; }
  .rail-bar { position: fixed; z-index: 20; left: 0; right: 0; top: 0; height: 2px; background: var(--red); transform: scaleX(0); transform-origin: left; }
  @media (min-width: 1200px) { .rail-bar { display: none; } }
  @media (max-width: 1199px) { .rail { display: none; } }
</style>
