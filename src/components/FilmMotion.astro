    [data-fm='bloom'].m-armed.m-in .fm-still { transition: transform 1.8s var(--ease); }

    /* Letterbox: two bars cover 12.5% top and bottom, then retract to the full frame. */
    [data-fm='letterbox'].m-armed::before, [data-fm='letterbox'].m-armed::after { content: ''; position: absolute; left: 0; right: 0; height: 12.5%; z-index: 1; background: var(--night); pointer-events: none; transform: scaleY(1); }
