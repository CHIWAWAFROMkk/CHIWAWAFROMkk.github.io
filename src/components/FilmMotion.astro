    [data-fm='bloom'].m-armed .fm-still, [data-fm='bloom'].m-armed .fm-mono { transform: scale(1.035); }
    [data-fm='bloom'].m-armed.m-in .fm-mono { opacity: 0; transition: opacity 1.6s var(--ease) 0.35s, transform 1.8s var(--ease); }
