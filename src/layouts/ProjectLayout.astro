---
import Base from './Base.astro';
import SectionReveals from '../components/SectionReveals.astro';
import ProjectMotion from '../components/ProjectMotion.astro';
import { countableSegments } from '../scripts/motion/countable';
import SplitText from '../components/rb/SplitText.astro';
import ScrollReveal from '../components/rb/ScrollReveal.astro';
import { SITE } from '../data/site';
import { localizePath, type Lang, type Bi } from '../i18n';

export interface Summary { task: Bi; mine: Bi; tools: Bi; evidence: Bi; status: Bi }
interface Props { lang: Lang; slug: string; title: Bi; lead: Bi; tags: Bi[]; summary: Summary; description: Bi; night?: boolean; motion?: boolean; deferTitle?: boolean }
const { lang, slug, title, lead, tags, summary, description, night = false, motion = true, deferTitle = false } = Astro.props;
const path = `/projects/${slug}/`;
const order = SITE.projects;
const i = order.findIndex(p => p.slug === slug);
const prev = i > 0 ? order[i - 1] : undefined;
const next = i >= 0 && i < order.length - 1 ? order[i + 1] : undefined;
const S = SITE.summaryLabels;
const rows: [Bi, Bi][] = [[S.task, summary.task], [S.mine, summary.mine], [S.tools, summary.tools], [S.evidence, summary.evidence], [S.status, summary.status]];
---
<Base lang={lang} path={path} night={night} title={`${title[lang]} · ${SITE.name[lang]}`} description={description[lang]}>
  <main id="main" data-section-reveals={motion ? '' : undefined}>
    <slot name="top" />
    <header class="p-head wrap">
      <ul class="p-tags">{tags.map(t => <li>{t[lang]}</li>)}</ul>
      <h1 class="p-title">{motion ? <SplitText text={title[lang]} deferUntilVisible={deferTitle} /> : title[lang]}</h1>
      <p class="p-lead">{motion ? <ScrollReveal text={lead[lang]} /> : lead[lang]}</p>
    </header>
    <section class="p-summary wrap" aria-labelledby="p-summary-h">
      <h2 id="p-summary-h" class="label">{S.heading[lang]}</h2>
      <dl>{rows.map(([k, v]) => <div class="p-row" data-m-pre={motion ? '' : undefined}><dt>{k[lang]}</dt><dd>{motion ? countableSegments(v[lang]).map(s => s.count ? <span class="p-count" data-count>{s.text}</span> : s.text) : v[lang]}</dd></div>)}</dl>
    </section>
    <slot name="demo" />
    <article class="prose wrap"><slot /></article>
    <nav class="p-pager wrap" aria-label={SITE.pager.label[lang]}>
      {prev ? <a href={localizePath(prev.href, lang)}>← {prev.title[lang]}</a> : <span></span>}
      {next && <a href={localizePath(next.href, lang)}>{next.title[lang]} →</a>}
    </nav>
  </main>
  {motion && <SectionReveals />}
  {motion && <ProjectMotion />}
</Base>
<style>
  .p-head { display: grid; gap: 18px; padding-block: clamp(32px, 6vh, 72px) 36px; border-bottom: var(--rule); }
  .p-tags { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; list-style: none; }
  .p-tags li { padding: 3px 10px; border: 1.5px solid var(--ink); font-size: 13px; font-weight: 500; }
  .p-title { font-size: clamp(44px, 7.5vw, 112px); line-height: 0.95; letter-spacing: -0.04em; }
  .p-lead { max-width: 30em; font: 500 clamp(18px, 1.7vw, 24px)/1.5 var(--font-body); }
  .p-summary { padding-block: 36px 48px; }
  .p-summary .label { margin-bottom: 16px; color: var(--red-text); }
  .p-row { display: grid; grid-template-columns: minmax(7em, 14em) 1fr; gap: 8px 32px; padding-block: 14px; border-top: var(--hair); }
  .p-row dt { font: 900 16px/1.6 var(--font-cjk-bold); }
  .p-row dd { max-width: 48em; }
  .p-count { white-space: nowrap; font-variant-numeric: tabular-nums; }
  /* Summary rows (ProjectMotion): held before the script, then the rule draws, the label and the text follow. */
  :global(html.motion-ok:not(.motion-timeout)) .p-row[data-m-pre]:not(:global(.m-armed)) { border-top-color: transparent; }
  :global(html.motion-ok:not(.motion-timeout)) .p-row[data-m-pre]:not(:global(.m-armed)) > * { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .p-row:global(.m-armed) { position: relative; border-top-color: transparent; }
    .p-row:global(.m-armed)::before { content: ''; position: absolute; left: 0; right: 0; top: -1px; border-top: var(--hair); transform: scaleX(0); transform-origin: left; }
    .p-row:global(.m-armed) dt { opacity: 0; transform: translateX(-10px); }
    .p-row:global(.m-armed) dd { opacity: 0; transform: translateY(8px); }
    .p-row:global(.m-armed.m-in)::before { transform: none; transition: transform 0.8s var(--ease) var(--m-d, 0ms); }
    .p-row:global(.m-armed.m-in) dt { opacity: 1; transform: none; transition: opacity 0.6s var(--ease) calc(var(--m-d, 0ms) + 120ms), transform 0.8s var(--ease) calc(var(--m-d, 0ms) + 120ms); }
    .p-row:global(.m-armed.m-in) dd { opacity: 1; transform: none; transition: opacity 0.6s var(--ease) calc(var(--m-d, 0ms) + 220ms), transform 0.8s var(--ease) calc(var(--m-d, 0ms) + 220ms); }
  }
  .p-pager { display: flex; justify-content: space-between; gap: 16px; padding-block: 28px; border-top: var(--rule); font-weight: 500; }
  .p-pager a { text-decoration: none; }
  .p-pager a:hover { text-decoration: underline; text-underline-offset: 6px; }
  @media (max-width: 640px) {
    .p-row { grid-template-columns: 1fr; }
    /* One tag per line: the row's height no longer depends on whether the web font has arrived. */
    .p-tags { flex-direction: column; align-items: flex-start; }
  }
</style>
