---
import ProjectLayout from '../layouts/ProjectLayout.astro';
import CampusLive from '../components/CampusLive.astro';
import CampusFramework from '../components/CampusFramework.astro';
import { SITE } from '../data/site';
import { Content as BodyZh } from '../copy/projects/ai-campus.zh.md';
import { Content as BodyEn } from '../copy/projects/ai-campus.en.md';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const P = SITE.pages.aiCampus;
const Body = lang === 'zh' ? BodyZh : BodyEn;
---
<ProjectLayout lang={lang} slug="ai-campus" title={P.title} lead={P.lead} tags={P.tags} summary={P.summary} description={P.description}>
  <CampusLive slot="demo" lang={lang} />
  <CampusFramework slot="demo" lang={lang} />
  <Body />
</ProjectLayout>
