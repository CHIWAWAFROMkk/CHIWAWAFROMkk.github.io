---
import ProjectLayout from '../layouts/ProjectLayout.astro';
import QuotaShots from '../components/QuotaShots.astro';
import { SITE } from '../data/site';
import { Content as BodyZh } from '../copy/projects/quota-deck.zh.md';
import { Content as BodyEn } from '../copy/projects/quota-deck.en.md';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const P = SITE.pages.quota;
const Body = lang === 'zh' ? BodyZh : BodyEn;
---
<ProjectLayout lang={lang} slug="quota-deck" title={P.title} lead={P.lead} tags={P.tags} summary={P.summary} description={P.description}>
  <QuotaShots slot="demo" lang={lang} />
  <Body />
</ProjectLayout>
