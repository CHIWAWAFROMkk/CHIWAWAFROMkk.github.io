---
import ProjectLayout from '../layouts/ProjectLayout.astro';
import CareerDemo from '../components/CareerDemo.astro';
import EditionTeaser from '../components/EditionTeaser.astro';
import PlateCareer from '../components/PlateCareer.astro';
import { SITE } from '../data/site';
import { Content as BodyZh } from '../copy/projects/ai-career.zh.md';
import { Content as BodyEn } from '../copy/projects/ai-career.en.md';
import type { Lang } from '../i18n';
import type { Track } from '../data/tracks';
interface Props { lang: Lang; track?: Track }
const { lang, track = 'ai' } = Astro.props;
const P = SITE.pages.career;
const Body = lang === 'zh' ? BodyZh : BodyEn;
---
<ProjectLayout track={track} lang={lang} slug="ai-career" title={P.title} lead={P.lead} tags={P.tags} summary={P.summary} description={P.description}>
  <Fragment slot="demo">
    <CareerDemo lang={lang} />
    <EditionTeaser which="career" lang={lang} track={track} />
    <PlateCareer lang={lang} />
  </Fragment>
  <Body />
</ProjectLayout>
